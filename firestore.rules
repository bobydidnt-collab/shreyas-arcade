rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Username checks (kept in sync with nameProblem() in index.html).
    function normName(n) {
      return n.lower().replace('_', '').replace('0', 'o').replace('1', 'i').replace('3', 'e')
        .replace('4', 'a').replace('5', 's').replace('7', 't').replace('8', 'b').replace('9', 'g');
    }
    function nameAllowed(n) {
      let x = normName(n);
      let letters = x.replace('[0-9]', '');
      let plain = n.lower().replace('[_0-9]', '');
      let trail = normName(n.replace('_', '').replace('[0-9]+$', '')).replace('[0-9]', '');
      return !letters.matches('^(shreyas|realshreyas|theshreyas|therealshreyas|shreyasofficial|officialshreyas|shreyasreal|imshreyas|iamshreyas|itsshreyas|admin|administrator|moderator|mod|owner|staff|system|support|developer|dev)$')
        && !letters.matches('^(ass|cock|cum|tits|pedo|fag|hoe|spic|coon|anal|rape|kys|dick|butt|poop|pee)$')
        && !plain.matches('^(shreyas|realshreyas|theshreyas|therealshreyas|shreyasofficial|officialshreyas|shreyasreal|imshreyas|iamshreyas|itsshreyas|admin|administrator|moderator|mod|owner|staff|system|support|developer|dev)$')
        && !plain.matches('^(ass|cock|cum|tits|pedo|fag|hoe|spic|coon|anal|rape|kys|dick|butt|poop|pee)$')
        && !trail.matches('^(shreyas|realshreyas|theshreyas|therealshreyas|shreyasofficial|officialshreyas|shreyasreal|imshreyas|iamshreyas|itsshreyas|admin|administrator|moderator|mod|owner|staff|system|support|developer|dev)$')
        && !trail.matches('^(ass|cock|cum|tits|pedo|fag|hoe|spic|coon|anal|rape|kys|dick|butt|poop|pee)$')
        && !x.matches('.*(fuck|fuk|fck|shit|bitch|cunt|nigg|niga|faggot|fagot|retard|whore|slut|porn|penis|vagina|pussy|dildo|rapist|nazi|hitler|kkk|asshole|bastard|boob|horny|sex|jizz|twat|wank|molest|pedophile|killyourself|tranny|chink|wetback|dyke|beaner|motherf|dumbass|jackass|testicle|nude|naked).*');
    }

    // One profile per account: the username shown on leaderboards.
    match /users/{uid} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['username', 'createdAt'])
        && request.resource.data.username is string
        && request.resource.data.username.matches('^[A-Za-z0-9_]{3,16}$')
        && nameAllowed(request.resource.data.username);
      allow update, delete: if false;
    }

    // Each player's best score per game. Anyone can read; only you can write yours,
    // only under your own username, and only if it beats your saved best.
    match /scores/{game}/entries/{uid} {
      allow read: if true;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && game.matches('^[a-z0-9]{1,20}$')
        && request.resource.data.keys().hasOnly(['username', 'score', 'at'])
        && request.resource.data.score is number
        && request.resource.data.score >= 0
        && request.resource.data.score < 1000000000000000
        && request.resource.data.at is number
        && request.resource.data.username == get(/databases/$(database)/documents/users/$(uid)).data.username
        && (resource == null || request.resource.data.score > resource.data.score);
      allow delete: if false;
    }

    // Feedback: signed-in players only, one message every 3 minutes per account.
    // Nobody can read it from the website; the owner reads it in the Firebase console.
    match /feedback/{id} {
      allow read, update, delete: if false;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid', 'username', 'topic', 'message', 'at'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.username
        && request.resource.data.topic is string && request.resource.data.topic.size() <= 60
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 3 && request.resource.data.message.size() <= 1000
        && request.resource.data.at == request.time
        && getAfter(/databases/$(database)/documents/feedbackLimits/$(request.auth.uid)).data.lastAt == request.time;
    }
    match /feedbackLimits/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['lastAt'])
        && request.resource.data.lastAt == request.time;
      allow update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['lastAt'])
        && request.resource.data.lastAt == request.time
        && request.time > resource.data.lastAt + duration.value(3, 'm');
      allow delete: if false;
    }
  }
}
